# Copy to .env (the root `npm run setup` does this for you).
# NEXT_PUBLIC_* values are built into the browser bundle; restart `npm run dev`
# after changing them.

# Base URL of the NestJS API (see backend/.env PORT).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Must match MAX_UPLOAD_MB in backend/.env; used for an instant size check.
NEXT_PUBLIC_MAX_UPLOAD_MB=20
