# Copy to .env (the root `npm run setup` does this for you).

# HTTP port of the NestJS API.
PORT=4000

# Origin of the Next.js frontend, allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection. Defaults match docker-compose.yml.
DB_HOST=localhost
DB_PORT=5433
DB_USER=pdfreader
DB_PASSWORD=pdfreader
DB_NAME=pdfreader

# Largest PDF accepted by the upload endpoint, in megabytes.
MAX_UPLOAD_MB=20

# Folder (relative to backend/) where original PDFs are stored.
UPLOAD_DIR=uploads
